<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络权限 (用于 MusicBrainz 与 Cover Art Archive 在线封面检索) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 音频读取、管理与存储权限 (Android 11+ MANAGE_EXTERNAL_STORAGE, Android 13+ READ_MEDIA_AUDIO, 低版本 READ/WRITE_EXTERNAL_STORAGE) -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 车载媒体中心权限与服务发现 (适配吉利/领克/极氪/银河等车载系统) -->
    <uses-permission android:name="ecarx.oem.permission.OPENAPI_MEDIACENTER_PERMISSION" />
    <permission
        android:name="com.orbit.music.source"
        android:protectionLevel="normal" />
    <uses-permission android:name="com.orbit.music.source" />
    <uses-permission android:name="music.intent.action.source" />
    <uses-permission android:name="com.flyme.auto.coreservice.permission.CONNECTION" />
    <uses-permission android:name="android.car.permission.CAR_VENDOR_EXTENSION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <package android:name="com.ecarx.sdk.openapi" />
        <package android:name="com.ecarx.eas.carservice" />
        <package android:name="com.flyme.auto.music" />
        <package android:name="com.flyme.auto.mediacontrol" />
        <package android:name="com.flyme.auto.dimservice" />
        <package android:name="com.geely.auto.music" />
    </queries>

    <!-- 声明支持所有屏幕尺寸与像素密度 (支持车载大屏与高分屏) -->
    <supports-screens
        android:anyDensity="true"
        android:largeScreens="true"
        android:normalScreens="true"
        android:smallScreens="true"
        android:xlargeScreens="true" />

    <application
        android:name=".EqualizerApp"
        android:allowBackup="true"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:resizeableActivity="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MusicEqualizer">

        <!-- 声明支持超宽屏车载大屏比例 (支持 21:9、8:3 等比例铺满全屏) -->
        <meta-data
            android:name="android.max_aspect"
            android:value="3.2" />

        <!-- 亿咖通 / 吉利银河 OS / 领克 Flyme Auto 车机媒体与语音识别元数据 -->
        <meta-data
            android:name="ECARX_VR_APP_NAME_EXPAND"
            android:value="在线音乐|恒星律动|音乐|本地音乐|OrBitPlayer" />
        <meta-data
            android:name="eCarX_OpenAPI_AppId"
            android:value="338018" />
        <meta-data
            android:name="eCarX_OpenAPI_AppKey"
            android:value="DXeoZ25hdrtMjgGY3OJA" />
        <meta-data
            android:name="app_unite_code"
            android:value="flyme_music_unit_code" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:theme="@style/Theme.MusicEqualizer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 声明系统默认音乐播放器类别 (系统“默认应用 -> 音乐应用”扫描识别项) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.APP_MUSIC" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- 响应各类本地和外部音频文件打开意图 (支持文件管理器默认应用关联) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="application/x-ogg" />
                <data android:mimeType="application/itunes" />
            </intent-filter>

            <!-- 响应语音助手/媒体搜索播放 -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 声明支持 Android Automotive 与车载媒体中心识别 -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <service
            android:name=".service.EqualizerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Media3 / MediaBrowser 车载多媒体服务 (兼容所有车机音源与桌面卡片) -->
        <service
            android:name=".service.MusicPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <!-- 增强媒体会话感知服务 (类似 Wavelet / Poweramp EQ) -->
        <service
            android:name=".audio.MediaNotificationListener"
            android:label="Equalizer Media Listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 接收三方播放器 AudioSession 打开/关闭广播 -->
        <receiver
            android:name=".audio.AudioSessionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.action.OPEN_AUDIO_EFFECT_CONTROL_SESSION" />
                <action android:name="android.media.action.CLOSE_AUDIO_EFFECT_CONTROL_SESSION" />
            </intent-filter>
        </receiver>

        <!-- 接收通知栏上一曲/下一曲/播放暂停控制广播 -->
        <receiver
            android:name=".service.PlaybackControlReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.orbit.music.ACTION_PREV" />
                <action android:name="com.orbit.music.ACTION_PLAY_PAUSE" />
                <action android:name="com.orbit.music.ACTION_NEXT" />
            </intent-filter>
        </receiver>

        <!-- 单曲专属高保真封面内容提供者 (杜绝 albumId 混淆串台) -->
        <provider
            android:name=".data.provider.AudioCoverProvider"
            android:authorities="com.orbit.music.cover"
            android:exported="true"
            android:grantUriPermissions="true" />

        <!-- 车载方向盘按键与硬件媒体按键广播拦截器 (支持方向盘上一曲/下一曲/播放/暂停) -->
        <receiver
            android:name=".car.OrbitMediaButtonReceiver"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MEDIA_BUTTON" />
                <action android:name="com.tencent.qqmusiccar.action.MEDIA_BUTTON_INNER_MUSICMEDIA" />
                <action android:name="com.tencent.qqmusiccar.action.MEDIA_BUTTON_INNER_ONKEY" />
            </intent-filter>
        </receiver>

        <!-- 车载系统音源切换与开机唤醒广播接收器 -->
        <receiver
            android:name=".car.OrbitCarBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="ecarx.xsf.mediacenter.action.BROADCAST_MEDIA_CENTER" />
                <action android:name="ecarx.xsf.mediacenter.action.BROADCAST_MEDIA_CENTER.SEMANTIC" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="ecarx.intent.action.power.STRMODE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- 车载媒体恢复与音源唤起服务 (响应车机中控选择与熄火唤醒续播) -->
        <service
            android:name=".car.OrbitCarRecoveryService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.orbit.music.recovery" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

    </application>

</manifest>
